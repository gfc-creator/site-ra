---
/**
 * Vídeo de rede social que só carrega depois do clique: até lá, a página não
 * chama o Facebook, o Instagram nem o YouTube (privacidade, LGPD).
 */
interface Props {
  plataforma: "facebook" | "instagram" | "youtube";
  url: string;
  titulo: string;
  autor?: string;
}

const { plataforma, url, titulo, autor } = Astro.props;
const nomes = { facebook: "Facebook", instagram: "Instagram", youtube: "YouTube" };
const nome = nomes[plataforma];

function endereco(): string {
  if (plataforma === "facebook") {
    return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false`;
  }
  if (plataforma === "instagram") {
    return `${url.split("?")[0].replace(/\/$/, "")}/embed/`;
  }
  const id = new URL(url).searchParams.get("v") ?? url.split("/").pop();
  return `https://www.youtube-nocookie.com/embed/${id}`;
}
---

<figure class="video-externo grid max-w-sm gap-2" data-src={endereco()} data-titulo={titulo}>
  <div class="moldura grid aspect-[9/16] w-full place-content-center gap-4 rounded-md bg-azul-950 p-6 text-center text-neutro-0">
    <svg viewBox="0 0 64 64" class="mx-auto size-16" aria-hidden="true">
      <circle cx="32" cy="32" r="30" fill="var(--cor-ambar-500)"></circle>
      <path d="M26 20v24l19-12Z" fill="var(--cor-azul-950)"></path>
    </svg>
    <p class="font-titulo text-lg font-extrabold">{titulo}</p>
    <button type="button" class="botao botao-sol">
      Assistir ao vídeo
    </button>
    <p class="text-sm text-azul-100">
      O vídeo é carregado do {nome}, que pode usar cookies. Nada é enviado ao {nome} antes do
      clique.
    </p>
  </div>
  <figcaption class="text-sm text-neutro-600">
    {autor ? `Vídeo de ${autor}, no ${nome}.` : `Vídeo publicado no ${nome}.`}{" "}
    <a href={url} rel="noopener">
      Abrir no {nome}
    </a>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".video-externo").forEach((figura) => {
    figura.querySelector("button")?.addEventListener("click", () => {
      const moldura = figura.querySelector(".moldura");
      if (!moldura) return;
      const quadro = document.createElement("iframe");
      quadro.src = figura.dataset.src ?? "";
      quadro.title = figura.dataset.titulo ?? "Vídeo";
      quadro.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      quadro.allowFullscreen = true;
      quadro.className = "aspect-[9/16] w-full rounded-md border-0 bg-azul-950";
      moldura.replaceWith(quadro);
      quadro.focus();
    });
  });
</script>
