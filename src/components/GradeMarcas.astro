---
import type { Marca } from "../lib/vitrine";

interface Props {
  titulo: string;
  marcas: Marca[];
  imagemPadrao: string;
}

const { titulo, marcas, imagemPadrao } = Astro.props;
---

<div class="grid gap-4">
  <h3 class="text-xl">{titulo}</h3>
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {marcas.map((marca) => {
      const conteudo = (
        <>
          <span class="flex h-16 w-full items-center justify-center">
            <img
              src={marca.logo ?? imagemPadrao}
              alt=""
              loading="lazy"
              decoding="async"
              class="max-h-16 w-auto max-w-full object-contain"
            />
          </span>
          <span class="font-titulo font-semibold">{marca.nome}</span>
        </>
      );
      return (
        <li class="grid content-start justify-items-center gap-2 rounded-md border border-neutro-200 bg-neutro-0 p-4 text-center">
          {marca.site ? (
            <a href={marca.site} rel="noopener" class="grid w-full justify-items-center gap-2">
              {conteudo}
            </a>
          ) : (
            conteudo
          )}
          {marca.atuacao && <span class="text-sm text-neutro-600">{marca.atuacao}</span>}
        </li>
      );
    })}
  </ul>
</div>
