---
import { empresa } from "../lib/empresa";
import { temVitrine } from "../lib/vitrine";

const links = [
  { href: "/#solucoes", rotulo: "Soluções" },
  { href: "/#como-trabalhamos", rotulo: "Como trabalhamos" },
  ...(temVitrine ? [{ href: "/#parceiros-e-clientes", rotulo: "Parceiros e clientes" }] : []),
  { href: "/#simulador", rotulo: "Simulador solar" },
  { href: "/#contato", rotulo: "Contato" },
];
---

<header class="sticky top-0 z-40 border-b border-azul-900 bg-azul-950 text-neutro-0">
  <div class="contido flex min-h-[4.5rem] items-center justify-between gap-4">
    <a href="/" class="font-titulo text-xl font-extrabold no-underline">
      RA Tech <span class="font-semibold text-azul-300">Energia</span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm no-underline hover:text-ambar-500">
          {l.rotulo}
        </a>
      ))}
      <a href={empresa.whatsapp} class="botao botao-sol" rel="noopener">
        Falar no WhatsApp
      </a>
    </nav>

    <details class="group md:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center rounded border border-azul-300 px-4 [&::-webkit-details-marker]:hidden">
        Menu
      </summary>
      <nav
        aria-label="Principal no celular"
        class="absolute inset-x-0 top-full grid gap-1 border-b border-azul-900 bg-azul-950 px-5 pb-5 pt-2"
      >
        {links.map((l) => (
          <a href={l.href} class="flex min-h-11 items-center no-underline">
            {l.rotulo}
          </a>
        ))}
        <a href={empresa.whatsapp} class="botao botao-sol mt-2" rel="noopener">
          Falar no WhatsApp
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Ao escolher uma seção no celular, o menu fecha e libera a tela.
  document.querySelectorAll("header details a").forEach((link) => {
    link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
  });
</script>
