---
import { Font } from "astro:assets";
import "../styles/global.css";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import { empresa } from "../lib/empresa";

interface Props {
  titulo?: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${empresa.marca}` : empresa.marca;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--fonte-titulo" preload />
    <Font cssVariable="--fonte-texto" preload />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-neutro-0 focus:px-4 focus:py-2"
    >
      Ir para o conteúdo
    </a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
